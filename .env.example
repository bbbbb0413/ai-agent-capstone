# .env로 복사해서 값을 채운다. .env는 git에 올리지 않는다.

# LLM
OPENAI_API_KEY=
LLM_MODEL=gpt-5-mini
FALLBACK_MODEL=gpt-5-nano
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# LangSmith (Observability)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=opslens

# 작업 전달 방식: http(MVP) | kafka(가산점, --profile queue 필요)
DISPATCH_MODE=http

# 인증
JWT_SECRET=          # 32바이트 이상 임의 문자열
SERVICE_TOKEN=       # 내부 서비스 간 호출 토큰
ALERT_WEBHOOK_TOKEN= # Alertmanager → backend webhook 토큰

# PostgreSQL (서비스별 계정 분리)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
AGENT_DB_PASSWORD=
INDEXER_DB_PASSWORD=
RAG_DB_PASSWORD=

# Grafana
GRAFANA_ADMIN_PASSWORD=
