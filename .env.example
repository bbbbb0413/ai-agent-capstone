# .env로 복사해서 쓴다: cp .env.example .env
# .env는 git에 올리지 않는다.
# 아래 비밀 값은 로컬 개발용 샘플이다. 공유 서버나 발표 환경에서는 새 값으로 바꾼다.

# ── 직접 넣어야 하는 값 ──────────────────────────────────────
OPENAI_API_KEY=
LANGSMITH_API_KEY=
# GitOps 고객사(A사) 조치 PR용. 이 저장소에만 Contents·Pull requests 쓰기 권한이 있는 fine-grained 토큰
GITHUB_TOKEN=
# 장애 형태 판정(Jev, docs/jev.md). 비우면 Jev를 부르지 않고 GPT가 판정한다
TYPESAFE_API_KEY=

# LLM
LLM_MODEL=gpt-5-mini
FALLBACK_MODEL=gpt-5-nano
# 추론 강도(minimal|low|medium|high). 비우면 모델 기본값. 추론 모델이 아니면 비운다
LLM_REASONING_EFFORT=low
# 진단 첫 턴 도구 호출 강제. 강제 없이 비교 평가할 때만 false
DIAGNOSE_FORCE_FIRST_TOOL=true
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# LangSmith (Observability). 키를 넣었으면 true로 바꾼다
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=opslens

# 작업 전달 방식: kafka(기본, SLA 등급별 대기열) | http(Kafka 없이 agent를 바로 호출)
DISPATCH_MODE=kafka

# 테스트용 자동 승인 허용. true면 관리자가 운영 화면의 체크박스로 자동 승인을 켜고 끌 수 있다.
# 켜면 승인 요청(조치·담당자 호출·고객 공지)을 사람 대신 바로 승인한다. 운영 환경에서는 false로 두어 체크박스를 없앤다
AUTO_APPROVE_ALLOWED=true

# ── 인증 (로컬 개발용 샘플) ──────────────────────────────────
# JWT 서명 키. HS256이라 32바이트 이상이어야 한다
JWT_SECRET=opslens-local-jwt-secret-change-me-0123456789abcdef
# 내부 서비스 간 호출 토큰 (backend, agent, MCP Server, demo-app)
SERVICE_TOKEN=opslens-local-service-token-change-me
# Alertmanager → backend webhook 토큰
ALERT_WEBHOOK_TOKEN=opslens-local-alert-token-change-me

# ── PostgreSQL (서비스별 계정 분리, 로컬 개발용 샘플) ─────────
POSTGRES_PASSWORD=postgres-local-pw
APP_DB_PASSWORD=app-local-pw
AGENT_DB_PASSWORD=agent-local-pw
INDEXER_DB_PASSWORD=indexer-local-pw
RAG_DB_PASSWORD=rag-local-pw

# ── Grafana (로컬 개발용 샘플) ───────────────────────────────
GRAFANA_ADMIN_PASSWORD=grafana-local-pw

# 선택: Slack Webhook DB 암호화 전용 키. 생략하면 JWT_SECRET에서 용도를 분리해 유도한다.
# 키를 변경하면 관리자 설정에서 Webhook URL을 다시 입력해야 한다.
SLACK_ENCRYPTION_KEY=

# 로컬 backend 직접 실행 시 Prometheus 주소 (compose 내부 기본값은 prometheus:9090)
# PROMETHEUS_URL=http://127.0.0.1:9090
