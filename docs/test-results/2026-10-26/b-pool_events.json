    "type": "APPROVAL_REQUIRED",
    "data": {
      "args": {
        "reason": "RB-STD-01에 따른 롤백 조치가 필요하나 계약상 롤백은 고객 승인 필요로 즉시 실행 불가.",
        "service": "reservation-api",
        "category": "ACTION_BLOCKED",
        "blocked_by": "CONTRACT",
