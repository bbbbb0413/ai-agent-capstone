<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty name="TENANT_ID" source="demo.tenant-id"/>
    <springProperty name="SERVICE_NAME" source="demo.service-name"/>
    <springProperty name="LOKI_URL" source="demo.loki-url"/>

    <!-- 고객사별 X-Scope-OrgID(tenantId)로 로그를 분리해서 Loki에 보낸다.
         service 라벨은 메트릭의 service 라벨과 같은 값이다. 진단이 서비스별로 로그를 거른다 -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <labels>
            app = demo-app
            tenant = ${TENANT_ID}
            service = ${SERVICE_NAME}
            level = %level
        </labels>
        <message>
            <pattern>%-5level [%thread] %logger{20} - %msg%n</pattern>
        </message>
        <http>
            <url>${LOKI_URL}</url>
            <tenantId>${TENANT_ID}</tenantId>
        </http>
        <batch>
            <maxItems>50</maxItems>
            <timeoutMs>1000</timeoutMs>
        </batch>
    </appender>

    <!-- 부하 발생기는 고객사 밖의 사용자 역할이라 로그를 Loki로 보내지 않는다 -->
    <springProfile name="!loadgen">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>
    <springProfile name="loadgen">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
